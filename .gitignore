# --- паспорта реальных приборов -------------------------------------------
# Публичный репозиторий не место для данных отдельного изделия (решение
# владельца В-40). Паспорт кладётся рядом с программой и передаётся файлом,
# а не коммитом. Обезличенный образец лежит внутри пакета и трекается явно.
passports/*.json
!attenuator_app/passports/SAMPLE.json
!attenuator_app/tools/calibration/SAMPLE.json

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- сборка ---------------------------------------------------------------
build/dist/
build/build/
*.spec.bak

# --- среда ----------------------------------------------------------------
.vscode/
.idea/
*.log
