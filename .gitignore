# --- паспорта реальных приборов -------------------------------------------
# Публичный репозиторий не место для данных отдельного изделия (решение
# владельца В-40). Паспорт кладётся рядом с программой и передаётся файлом,
# а не коммитом. Обезличенный образец лежит внутри пакета и трекается явно.
passports/*.json
!attenuator_app/passports/SAMPLE.json
!attenuator_app/tools/calibration/SAMPLE.json

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# --- сборка ---------------------------------------------------------------
build/dist/
build/build/
*.spec.bak

# --- среда ----------------------------------------------------------------
.vscode/
.idea/
*.log

# --- мусор из апстрима скилла ---------------------------------------------
# В multi-agent-coordination-skill закоммичены __pycache__/*.pyc (22 шт., их
# имена длиннее лимита Windows и ломают клонирование) и .coverage. При
# обновлении скилла они не должны приезжать сюда.
.coverage

# --- песочницы ролей -------------------------------------------------------
.worktrees/

# --- снимки дымового прогона окна ------------------------------------------
# `smoke_cwapp` пишет в runs/cwapp_smoke 15 PNG живого окна при каждом прогоне.
# Это рабочий вывод проверки, а не артефакт поставки: в репозиторий не едет.
runs/
