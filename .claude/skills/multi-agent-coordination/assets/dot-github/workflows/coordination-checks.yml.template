# Coordination checks. Copy to .github/workflows/coordination-checks.yml (drop .template).
#
# Mirrors the checks the local hooks already do, on GitHub's runner, so a session that
# skipped a local hook does not land a broken commit unnoticed.
#
# The budget check WARNS; it does not fail the build. README.md, docs/ru/CONCEPT.md §3.1 and
# docs/ru/CROSS_PLATFORM_BRIDGE.md all describe it as a soft limit, and CONCEPT.md gives the
# reason: blocking on it complicates emergency work while adding nothing to correctness. An
# earlier version of this file exited 1, quietly turning a documented cost signal into a
# gate. If your project wants a real gate, the honest way is to run the hook with --strict
# in a separate, clearly-labelled job -- and to change those three documents to match.

name: Coordination checks

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

jobs:
  trailers:
    name: Commit trailers (CHARTER.md §4)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Check every commit in the PR, not just the head
        run: |
          # A five-commit PR used to have four commits go unchecked.
          if [ "${{ github.event_name }}" = "pull_request" ]; then
            range="${{ github.event.pull_request.base.sha }}..${{ github.event.pull_request.head.sha }}"
          else
            range="${{ github.sha }}~1..${{ github.sha }}"
          fi

          failed=0
          for sha in $(git rev-list "$range"); do
            subject=$(git log -1 --format=%s "$sha")
            # Merge commits are generated by GitHub and carry no trailers by design.
            if [ "$(git rev-list --parents -n 1 "$sha" | wc -w)" -gt 2 ]; then
              continue
            fi
            if [ -z "$(git log -1 --format=%B "$sha" | git interpret-trailers --parse)" ]; then
              echo "::error::commit $sha ($subject) has no parseable trailer block."
              echo "CHARTER.md §4: trailers must be the last paragraph, with a blank line"
              echo "before the block and no blank line inside it."
              failed=1
            fi
          done
          exit $failed

  budget:
    name: Cold-start budget (warn only)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Report oversized cold-start files
        run: |
          # --json gives a stable contract; the previous version grepped raw JSON for the
          # substring "systemMessage", which a role file could contain by accident.
          # $RUNNER_TEMP keeps the output out of the checkout, where it was never cleaned up.
          python .claude/hooks/check-context-budget.py --json --force \
            > "$RUNNER_TEMP/budget.json"
          python - "$RUNNER_TEMP/budget.json" <<'PY'
          import json, sys
          data = json.load(open(sys.argv[1], encoding="utf-8"))
          for item in data.get("oversized", []):
              print(f"::warning file={item['file']}::"
                    f"{item['bytes']} bytes exceeds the {item['limit']}-byte cold-start budget")
          for name in data.get("unreadable", []):
              print(f"::warning file={name}::could not be read to check its size")
          total = len(data.get("oversized", []))
          print(f"{total} file(s) over budget."
                if total else "All cold-start files are within budget.")
          PY

  blocking-questions:
    name: Blocking questions (waiting on the owner)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Fail while a role is stopped on an unanswered blocking question
        run: |
          # This check is RED on purpose while a blocking question is open, and it is the
          # only check here that is about people rather than code.
          #
          # PROJECT.md's question protocol says a `blocking` question means the role stops
          # and makes no changes until it is answered. Without this, that state is a row in
          # a markdown table nobody has a reason to open -- indistinguishable from progress.
          # A red check on the PR is the cheapest notification that needs no service, no
          # webhook, and no state outside git.
          #
          # Non-blocking questions do NOT fail: they have a documented default and the role
          # kept working, so failing on them would train everyone to ignore this check.
          python coordination/tools/build_index.py \
            --out "$RUNNER_TEMP/INDEX.md" --fail-on-blocking

  index-freshness:
    name: INDEX.md matches the journals
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Rebuild the index and compare it with the committed one
        run: |
          # INDEX.md is a PROJECTION, not a source: its counts, its BLOCKING section and its
          # line numbers are only as fresh as the last run of build_index.py. Nothing used to
          # verify that, so anyone reading it -- a person, or an external tool built against
          # the contract in the skill's references/extension-contract.md -- had no way to tell
          # whether they were looking at the journals or at a snapshot from three weeks ago.
          #
          # A separate job on purpose. Folded into blocking-questions above it would never run
          # while a blocker is open, which is exactly when the index matters most.
          #
          # Not generating INDEX.md at all is a valid choice, so its absence is not a failure.
          # The check is narrower than that: IF you publish this artifact, it must be true.
          if [ ! -f coordination/INDEX.md ]; then
            echo "coordination/INDEX.md is not committed; nothing to keep fresh."
            exit 0
          fi
          python coordination/tools/build_index.py --out "$RUNNER_TEMP/fresh-INDEX.md"
          if ! diff -u coordination/INDEX.md "$RUNNER_TEMP/fresh-INDEX.md"; then
            echo "::error file=coordination/INDEX.md::stale. Regenerate it and commit:"
            echo "  python coordination/tools/build_index.py --out coordination/INDEX.md"
            exit 1
          fi

  protocol-tests:
    name: Protocol tests (no dependencies)
    runs-on: ubuntu-latest
    strategy:
      matrix:
        # Both ends of the supported range, so the stdlib-only claim stays honest.
        python-version: ['3.9', '3.12']
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}

      - name: Run the suite with pytest as the only dependency
        run: |
          python -m pip install --quiet pytest
          python -m pytest -q -m "not streamlit"

  dashboard-tests:
    name: Dashboard tests (optional add-on)
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
          cache: pip

      - name: Run the full suite including the UI layer
        run: |
          python -m pip install --quiet \
            -r coordination/tools/dashboard/requirements.txt \
            -r coordination/tools/dashboard/requirements-dev.txt
          python -m pytest -q
